# Copy to .env and adjust. Never commit .env.

# SQLite database location (relative paths resolve from the project root)
DB_PATH=data/app.db

# Sent in the User-Agent header so publishers can identify/contact this client.
CONTACT_EMAIL=you@example.com

# HTTP behaviour
HTTP_CONNECT_TIMEOUT=5
HTTP_READ_TIMEOUT=20
# Minimum seconds between two requests to the same domain
DOMAIN_MIN_INTERVAL_SECONDS=5

# Trading days of NSE EOD prices to backfill (the daily technical screen needs >= 40)
PRICE_BACKFILL_DAYS=60

# Max characters of publisher-provided snippet kept per article
SNIPPET_MAX_CHARS=300
# Snippets older than this are purged (headline/metadata/recommendations are kept)
NEWS_RETENTION_DAYS=365

LOG_LEVEL=INFO

# ---- Optional AI assistance (off by default) ----
# Extraction fallback + labelled headline digests. Every AI-extracted field is verified
# verbatim against the source text before it is stored.
AI_ENABLED=false
ANTHROPIC_API_KEY=
# claude-haiku-4-5 is a cheaper alternative for this short-text workload
AI_MODEL=claude-opus-5
